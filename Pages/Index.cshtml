@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="row">
    <div class="col-md-4">
        <div class="card" style="width: 18rem;">
            <a asp-page="/Configuration/CargaXml"><img src="https://www.comunidadbaratz.com/wp-content/uploads/La-biblioteca-es-inclusion-social-e-igualdad-de-oportunidades.jpg" class="card-img-top" alt=""></a>
            <div class="card-body">
                <h3>Cargar Archivo de Configuracion</h3>
                <p class="card-text text-wrap">Sube un archivo XML de configuraciones para cargar la base de datos de la biblioteca </p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card" style="width: 18rem;">
            <a href="#"><img src="https://www.infotecarios.com/wp-content/uploads/bibliotecaria.png" class="card-img-top" alt=""></a>
            <div class="card-body">
                <h3>Ver Catalogo</h3>
                <p class="card-text text-wrap">Busca en nuestra variedad de categorias el libro que necesites.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card" style="width: 18rem;">
            <a asp-page="/RegistroLibro"><img src="https://s1.significados.com/foto/libro-interior-cke.jpg?class=article" class="card-img-top" alt=""></a>
            <div class="card-body">
                <h3>Registrar Nuevo Libro</h3>
                <p class="card-text text-wrap">Registra el libro que gustes en nuestra biblioteca.</p>
            </div>
        </div>
    </div>
</div>
