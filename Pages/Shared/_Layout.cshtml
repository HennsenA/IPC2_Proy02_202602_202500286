<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BibliotecaUsac</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IPC2_Proyecto2_S22026_202500286.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">BibliotecaUsac</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 justify-content-end">
                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle" data-bs-toggle="dropdown" role="button" aria-expanded="false" asp-area="" asp-page="/Index">Libros</a>
                            <ul class="dropdown-menu">
                                <li class="dropdown-item" href="#"><a class="nav-link text-dark" asp-page="/RegistroLibro">Registrar Nuevo Libro</a></li>
                                <li class="dropdown-item" href="#"><a class="nav-link text-dark" asp-page="/EliminarLibro">Eliminar Libro</a></li>
                                <li class="dropdown-item" href="#"><a class="nav-link text-dark" asp-page="/BuscarLibro">Buscar Libro</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li class="dropdown-item" href="#"><a class="nav-link text-dark" asp-page="/LibroMayorMenor" asp-route-tipo="0">Primer Libro</a></li>
                                <li class="dropdown-item" href="#"><a class="nav-link text-dark" asp-page="/LibroMayorMenor" asp-route-tipo="1">Ultimo Libro</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle" data-bs-toggle="dropdown" role="button" aria-expanded="false" asp-area="" asp-page="/Index">Catalogo</a>
                            <ul class="dropdown-menu">
                                <li class="dropdown-item" href="#">Ver Catalogo</li>
                                <li><hr class="dropdown-divider"></li>
                                <li class="dropdown-item" href="#"><a class="nav-link text-dark" asp-page="/RegistroCategoria">Registrar Categoria</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Ayuda</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - BibliotecaUsac - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
