@page
@model IPC2_Proyecto2_S22026_202500286.Pages.BuscarLibroModel
@{
    ViewData["Title"]= "Buscar Libro";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>@ViewData["Title"]</h1>
<div class="row">
    <div class="col-md-6">
        <h3>Seccion de Busqueda</h3>
        <form>
            <div class="mb-3">
                <label for="BookCode" class="form-label">ISBN</label>
                <input placeholder="Ingrese el isbn del libro que desea buscar" type="text" class="form-control" id="BookCode">
            </div>
            <button type="submit" class="btn btn-primary">Buscar</button>
        </form>
    </div>
    <div class="col-md-6" id="SearchResult">
        <h3>Resultado de la Busqueda</h3>
    </div>
</div>
