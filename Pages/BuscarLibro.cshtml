@page
@model IPC2_Proyecto2_S22026_202500286.Pages.BuscarLibroModel
@{
    ViewData["Title"]= "Buscar Libro";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>@ViewData["Title"]</h1>
<div class="row">
    <div class="col-md-6">
        <h3>Seccion de Busqueda</h3>
        <form method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="BookCode" class="form-label">ISBN</label>
                <input placeholder="Ingrese el isbn del libro que desea buscar" type="text" class="form-control" asp-for="BookCode">
            </div>
            <button type="submit" class="btn btn-primary">Buscar</button>
        </form>
    </div>
    <div class="col-md-6" id="SearchResult">
        <h3>Resultado de la Busqueda</h3>
        @if (Model.estado==0)//Código de operación exitosa
        {
            <div class="alert alert-success">
                @Model.mensaje
            </div>

            <div class="card">
                <div class="card-body">
                    <b>Isbn</b>: @Model.resultado.Dato.Isbn<br />
                    <b>Título</b>: @Model.resultado.Dato.Titulo<br />
                    <b>Autor</b>: @Model.resultado.Dato.Autor<br />
                    <b>Categoria</b>: @Model.resultado.Dato.Categoria
                </div>
            </div>
        }else if (Model.estado == 1)//Codigo de advertencia
        {
            <div class="alert alert-warning">
                @Model.mensaje
            </div>
        }
        else if(Model.estado == -1)//Error producido
        {
            <div class="alert alert-danger">
                @Model.mensaje
            </div>
        }
    </div>
</div>

